{
  "uid": "mlops-serving",
  "title": "MLOps serving: predictors",
  "tags": [
    "mlops",
    "serving"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "type": "row",
      "title": "Predictors",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Scrape state",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (inferenceservice) (up{job=\"serving/predictors\"})",
          "legendFormat": "{{inferenceservice}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {},
      "description": "1 when Prometheus reads /metrics. Alerts PredictorDown, PredictorMissing",
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Predict requests",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (inferenceservice) (rate(bentoml_service_request_total{job=\"serving/predictors\", path=\"/api/predict\"}[$__rate_interval])) or sum by (inferenceservice) (rate(predictor_requests_total{job=\"serving/predictors\"}[$__rate_interval]))",
          "legendFormat": "{{inferenceservice}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "description": "Predict calls only; BentoML probe paths (/readyz, /livez) left out",
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "5xx ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (inferenceservice) (rate(bentoml_service_request_total{job=\"serving/predictors\", path=\"/api/predict\", http_response_code=~\"5..\"}[$__rate_interval])) or sum by (inferenceservice) (rate(predictor_requests_total{job=\"serving/predictors\", code=~\"5..\"}[$__rate_interval]))) / (sum by (inferenceservice) (rate(bentoml_service_request_total{job=\"serving/predictors\", path=\"/api/predict\"}[$__rate_interval])) or sum by (inferenceservice) (rate(predictor_requests_total{job=\"serving/predictors\"}[$__rate_interval])))",
          "legendFormat": "{{inferenceservice}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {},
      "description": "Alert PredictorErrorRatio: above 5% for 10 minutes",
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Predict latency p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (inferenceservice, le) (rate(bentoml_service_request_duration_seconds_bucket{job=\"serving/predictors\", path=\"/api/predict\"}[$__rate_interval]))) or histogram_quantile(0.95, sum by (inferenceservice, le) (rate(predictor_request_duration_seconds_bucket{job=\"serving/predictors\"}[$__rate_interval])))",
          "legendFormat": "{{inferenceservice}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "description": "Alert PredictorSlow: above 1 s (capstone) or 2.5 s (idcard, movie) for 10 minutes",
      "id": 5
    },
    {
      "type": "table",
      "title": "Served model versions",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (inferenceservice, version) (predictor_model_info{job=\"serving/predictors\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "description": "Reported by the idcard and movie servers; the capstone version is v<MLflow version> in its image tag",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            }
          }
        }
      ],
      "id": 6
    },
    {
      "type": "row",
      "title": "Capstone URL classifier: predictions and input drift",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Predicted label share",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (prediction) (rate(capstone_predictions_total{job=\"serving/predictors\"}[$__rate_interval])) / ignoring (prediction) group_left sum(rate(capstone_predictions_total{job=\"serving/predictors\"}[$__rate_interval]))",
          "legendFormat": "{{prediction}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 60
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {},
      "description": "Which label request URLs get. Serving has no ground truth, so this shows whether the output distribution moves",
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Predicted label probability (softmax) quantiles",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(capstone_prediction_confidence_bucket{job=\"serving/predictors\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.1, sum by (le) (rate(capstone_prediction_confidence_bucket{job=\"serving/predictors\"}[$__rate_interval])))",
          "legendFormat": "p10",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {},
      "description": "Probability of the predicted label. A falling p10 means more requests the model is unsure about",
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Drifted column share of the last window",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(capstone_drift_share{job=\"serving/predictors\"})",
          "legendFormat": "drifted share",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "Every 100 request URLs, 8 columns KS-tested against the training URLs. 0.5 or more is dataset drift (alert CapstoneInputDrift)",
      "id": 10
    },
    {
      "type": "stat",
      "title": "Judged windows (dashboard range)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result) (increase(capstone_drift_windows_total{job=\"serving/predictors\"}[$__range]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {},
      "description": "drifted, not_drifted, error; error is a window whose report could not be made",
      "id": 11
    },
    {
      "type": "stat",
      "title": "Evidently uploads (dashboard range)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 20,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result) (increase(capstone_drift_uploads_total{job=\"serving/predictors\"}[$__range]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(capstone_drift_windows_dropped_total{job=\"serving/predictors\"}[$__range]))",
          "legendFormat": "dropped",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {},
      "description": "failed raises CapstoneDriftReportsFailing. Judgments feed the drift alert whether or not the upload works",
      "id": 12
    },
    {
      "type": "bargauge",
      "title": "KS p-value per column, last window",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 20,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (column) (capstone_drift_p_value{job=\"serving/predictors\"})",
          "legendFormat": "{{column}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      },
      "description": "A column below 0.05 drifted",
      "id": 13
    },
    {
      "type": "row",
      "title": "ID card detector and movie recommender: model output",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 14
    },
    {
      "type": "timeseries",
      "title": "ID card: mean detections per image",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(idcard_detections_per_image_sum{job=\"serving/predictors\"}[$__rate_interval])) / sum(rate(idcard_detections_per_image_count{job=\"serving/predictors\"}[$__rate_interval]))",
          "legendFormat": "mean",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Near 1 when each image holds one ID card. More zeros mean more missed images",
      "id": 15
    },
    {
      "type": "timeseries",
      "title": "ID card: detection confidence quantiles",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 26,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(idcard_detection_confidence_bucket{job=\"serving/predictors\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.1, sum by (le) (rate(idcard_detection_confidence_bucket{job=\"serving/predictors\"}[$__rate_interval])))",
          "legendFormat": "p10",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {},
      "id": 16
    },
    {
      "type": "timeseries",
      "title": "Movie: predicted rating quantiles of recommended movies",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 26,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(movie_recommendation_score_bucket{job=\"serving/predictors\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.9, sum by (le) (rate(movie_recommendation_score_bucket{job=\"serving/predictors\"}[$__rate_interval])))",
          "legendFormat": "p90",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 5
        },
        "overrides": []
      },
      "options": {},
      "description": "Predicted ratings (0.5 to 5) of the top-k movies returned",
      "id": 17
    }
  ]
}
